{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base-harness.local/config.json",
  "title": "Base Harness V2 configuration",
  "description": "TypeScript TUI host and protocol V2 verifier configuration.",
  "type": "object",
  "properties": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["adaptive", "manual"], "default": "adaptive" },
        "auto": { "type": "boolean", "default": true },
        "maxSameFailureRepairs": { "type": "integer", "minimum": 0, "default": 2 }
      }
    }
  },
  "additionalProperties": true
}
