{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base-harness.local/config.json",
  "title": "Base Harness V2 configuration",
  "description": "Base Harness Host configuration. Model and MCP settings are validated by the Host. Sidecar wire protocol v4.",
  "type": "object",
  "properties": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "fast",
            "adaptive",
            "strict"
          ],
          "default": "adaptive"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto"
        },
        "maxSameFailureRepairs": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "mode": {
          "type": "string",
          "enum": [
            "adaptive",
            "manual"
          ],
          "deprecated": true
        },
        "auto": {
          "type": "boolean",
          "deprecated": true
        }
      }
    },
    "kernel": {
      "type": "object",
      "properties": {
        "defaultDomain": {
          "enum": [
            "develop",
            "general"
          ],
          "default": "develop"
        }
      },
      "additionalProperties": true
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "adaptive",
            "manual"
          ]
        },
        "exploration": {
          "enum": [
            "adaptive",
            "always",
            "manual"
          ]
        },
        "maxParallelWorkUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
