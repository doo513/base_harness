{
  "$schema": "./runtime/base-harness.schema.json",
  "kernel": {
    "defaultDomain": "develop"
  },
  "verification": {
    "profile": "adaptive",
    "trigger": "auto",
    "maxSameFailureRepairs": 2
  },
  "orchestration": {
    "mode": "adaptive",
    "exploration": "adaptive",
    "maxParallelWorkUnits": 2
  },
  "mcp": {}
}
