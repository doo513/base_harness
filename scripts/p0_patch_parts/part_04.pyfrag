    'run_dir = "./run"\ndefault_model = "primary"\n',
    'run_dir = "./run"\nacceptance_commands = []\ndefault_model = "primary"\n',
)
replace_once(
    "harness.example.toml",
    '[security]\nstrict_layout = false\n',
    '[security]\nexecution_backend = "local"\nstrict_layout = false\n',
)
replace_once(
    "harness.example.toml",
    'require_sealed_oracle = false\n',
    'require_sealed_oracle = false\nrequire_oracle_isolation = false\n',
)

